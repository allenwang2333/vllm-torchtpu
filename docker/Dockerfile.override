# Dockerfile.override for vllm-torchtpu.
# This Dockerfile builds a local-wheel-override variant image that overrides the pre-installed
# torch-tpu with a wheel from an override container image, local path, or GCS URI.

ARG BASE_IMAGE
ARG OVERRIDE_SOURCE="us-docker.pkg.dev/ml-oss-artifacts-transient/torch-tpu-docker-container/torch-tpu:nightly-latest"
ARG USE_LOCAL_WHEELS="0"

# Step 1: The Siphon (extract local wheels from override source image)
FROM $OVERRIDE_SOURCE AS override-source

# Step 2: The Override Variant (reinstall torch-tpu wheel without dependencies)
FROM $BASE_IMAGE AS override-variant
ARG USE_LOCAL_WHEELS="0"
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=from=override-source,source=/,target=/override-source,ro \
    --mount=type=bind,source=.staged_override_wheels,target=/staged-wheels,ro \
    set -eu; \
    if [ "${USE_LOCAL_WHEELS}" = "1" ]; then \
      set -- /staged-wheels/*.whl; \
    else \
      set -- /override-source/opt/wheels/*.whl; \
    fi; \
    if [ ! -e "$1" ]; then echo "No torch-tpu wheels found in OVERRIDE_SOURCE" >&2; exit 1; fi; \
    uv pip install --system --force-reinstall --no-deps "$@";
