ARG BASE_IMAGE
ARG WHEEL_DIR="wheels"
FROM $BASE_IMAGE AS override-variant
ARG WHEEL_DIR
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=${WHEEL_DIR},target=/local-wheels,ro \
    set -eu; \
    set -- /local-wheels/*.whl; \
    if [ ! -e "$1" ]; then echo "No .whl files found in ${WHEEL_DIR}" >&2; exit 1; fi; \
    uv pip install --system --force-reinstall --no-deps "$@";
