+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Static checks for separately generated, isolated inverse-permutation LLO.
+
+Usage: python tests/kernels/check_inverse_permutation_llo.py \
+    baseline_inverse.llo candidate_inverse.llo
+
+Both inputs must contain ONLY the isolated inverse computation emitted by
+the unchanged local driver. Whole-decode assembly is not a valid input: the
+first expert sort remains and shares sorting code with the baseline inverse.
+This script reads artifacts; it does not compile, profile or measure cycles.
+Passing these checks does not establish latency improvement or correctness.
+"""
+
+import argparse
+import json
+import re
+from pathlib import Path
+
+LLO_CHECKS = (
+    (r"\bvlt\.8x128\.s32\b", "absent"),
+    (r"\bvsel\.8x128\b", "decrease"),
+    (r"\bvadd\.8x128\.s32\b", "increase"),
+)
+
+
+def check_llo(baseline: str, candidate: str) -> list[dict]:
+    if not baseline.strip() or not candidate.strip():
+        raise ValueError("Both isolated LLO inputs must be nonempty")
+    if not re.search(LLO_CHECKS[0][0], baseline):
+        raise ValueError("Baseline is missing the expected inverse-sort vlt")
+    results = []
+    for pattern, relation in LLO_CHECKS:
+        before = len(re.findall(pattern, baseline))
+        after = len(re.findall(pattern, candidate))
+        passed = {
+            "absent": after == 0,
+            "decrease": after < before,
+            "increase": after > before,
+        }[relation]
+        results.append(dict(pattern=pattern, relation=relation,
+                            baseline_count=before, candidate_count=after,
+                            passed=passed))
+    return results
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("baseline_inverse", type=Path)
+    parser.add_argument("candidate_inverse", type=Path)
+    args = parser.parse_args()
+    try:
+        results = check_llo(args.baseline_inverse.read_text(),
+                            args.candidate_inverse.read_text())
+    except (OSError, ValueError) as exc:
+        print(json.dumps(dict(passed=False, error=str(exc))))
+        return 1
+    passed = all(result["passed"] for result in results)
+    print(json.dumps(dict(scope="isolated inverse permutation", passed=passed,
+                          checks=results)))
+    return 0 if passed else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/kernels/test_inverse_permutation.py b/tests/kernels/test_inverse_permutation.py
