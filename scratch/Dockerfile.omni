ARG BASE_IMAGE="us-central1-docker.pkg.dev/cloud-tpu-multipod-dev/vllm-omni/vllm-omni-tpu:speechmaxxxing-v3"
FROM ${BASE_IMAGE}

WORKDIR /workspace

ENV VLLM_TARGET_DEVICE=empty
ENV UV_TORCH_BACKEND=cpu
ENV UV_LINK_MODE=copy
ENV VLLM_OMNI_VERSION_OVERRIDE=0.27.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.27.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_TORCHTPU=0.1.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_OMNI=0.27.0

RUN git config --global --add safe.directory '*'

COPY vllm-torchtpu /workspace/vllm-torchtpu
COPY vllm-omni /workspace/vllm-omni

RUN uv pip install --system --no-deps -e /workspace/vllm-torchtpu
RUN uv pip install --system --no-deps -e /workspace/vllm-omni

ENV PYTHONPATH=/workspace/vllm-torchtpu/src:/workspace/vllm-omni
WORKDIR /workspace/vllm-omni

RUN python3 -c "import torch; import vllm; import vllm_torchtpu; import vllm_omni; print('Verification success: Torch', torch.__version__, 'OmniPlatform:', vllm_omni.platforms.current_omni_platform)"

CMD ["/bin/bash"]
